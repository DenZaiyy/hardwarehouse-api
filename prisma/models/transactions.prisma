model Transactions {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  productId    String   @db.ObjectId
  type         Boolean
  oldQtt       Int
  newQtt       Int
  createdAt    DateTime @default(now())
  product      Products @relation(fields: [productId], references: [id])
  userId       String?
  userFullName String?
  // Commande de la boutique à l'origine d'une sortie de stock (POST /api/v1/stock-exits)
  orderReference String?

  @@index([productId])
  @@index([userId])
}
